#!/usr/bin/env bash
set -eu

if [[ "${1:-}" == "memory" ]]; then
    # /usr/sbin on most distributions, /usr/bin on merged-/usr systems like Arch.
    for dmidecode in /usr/sbin/dmidecode /usr/bin/dmidecode; do
        if [[ -x "$dmidecode" ]]; then
            exec "$dmidecode" -t memory
        fi
    done
    echo "dmidecode is not installed" >&2
    exit 127
fi

device="${1:-}"
if [[ ! "$device" =~ ^[[:alnum:]._-]+$ ]] || [[ ! -b "/dev/$device" ]]; then
    echo "Invalid block device" >&2
    exit 2
fi

for smartctl in /usr/sbin/smartctl /usr/bin/smartctl; do
    if [[ -x "$smartctl" ]]; then
        exec "$smartctl" --all --json=o "/dev/$device"
    fi
done

echo "smartctl is not installed" >&2
exit 127