#!/bin/sh
set -e

UNIT=lintask-server.service

if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
    if command -v deb-systemd-invoke >/dev/null 2>&1; then
        deb-systemd-invoke stop "$UNIT" >/dev/null || true
    else
        systemctl stop "$UNIT" >/dev/null 2>&1 || true
    fi
fi

# Remove byte-compiled files so dpkg leaves no __pycache__ behind.
if command -v py3clean >/dev/null 2>&1; then
    py3clean -p lintask || true
else
    find /usr/share/lintask -name '*.pyc' -delete 2>/dev/null || true
    find /usr/share/lintask -depth -type d -name __pycache__ -exec rmdir {} + 2>/dev/null || true
fi

exit 0
