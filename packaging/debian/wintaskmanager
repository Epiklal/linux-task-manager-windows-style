#!/bin/sh
# Starter des Debian-Pakets: das Programm liegt in /usr/share/wintaskmanager.
# Alle Argumente werden durchgereicht, z. B.  wintaskmanager --server --token ...
#
# PySide6 kommt entweder aus den Systempaketen (Debian) oder aus der virtuellen
# Umgebung /opt/wintaskmanager/venv, die setup-venv bei der Installation anlegt
# (Ubuntu/Linux Mint haben keine PySide6-Pakete). Geprüft wird nur, ob die Module
# auffindbar sind - das kostet beim Start kaum Zeit.
APP=/usr/share/wintaskmanager/main.py
VENV=/opt/wintaskmanager/venv
CHECK='import importlib.util, sys
sys.exit(any(importlib.util.find_spec(m) is None for m in ("PySide6", "psutil")))'

for py in "$VENV/bin/python" /usr/bin/python3; do
    if [ -x "$py" ] && "$py" -c "$CHECK" 2>/dev/null; then
        exec "$py" "$APP" "$@"
    fi
done

message="wintaskmanager: Die Python-Module PySide6/psutil fehlen.
Bitte einmalig im Terminal ausführen:  sudo /usr/libexec/wintaskmanager/setup-venv"
echo "$message" >&2
# Beim Start aus dem Menü sieht niemand stderr: dort gibt es einen Dialog.
if [ ! -t 2 ] && { [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ]; }; then
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title=WinTaskManager --text="$message"
    elif command -v kdialog >/dev/null 2>&1; then
        kdialog --title WinTaskManager --error "$message"
    elif command -v xmessage >/dev/null 2>&1; then
        xmessage "$message"
    fi
fi
exit 1
