#!/bin/sh
# Sets up PySide6/psutil for the task manager. Called by postinst, but can be
# repeated by hand at any time:
#     sudo /usr/libexec/lintask/setup-venv
#
# Debian ships PySide6 as system packages (python3-pyside6.*), Ubuntu and
# Linux Mint don't. Without them, a virtual environment is created under
# /opt/lintask/venv and pip downloads PySide6-Essentials into it. The
# launcher /usr/bin/lintask picks the right Python environment by itself.
set -e

VENV=/opt/lintask/venv
PYTHON=/usr/bin/python3
CHECK='import PySide6, PySide6.QtCore, PySide6.QtGui, PySide6.QtWidgets, psutil
import sys; sys.exit(PySide6.__version_info__ < (6, 6))'

say() { echo "lintask: $*"; }
case "${LANGUAGE:-${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}}" in
    de*) GERMAN=1 ;;
    *) GERMAN= ;;
esac
# msg GERMAN ENGLISH
msg() { if [ -n "$GERMAN" ]; then say "$1"; else say "$2"; fi; }

if [ -x "$VENV/bin/python" ] && "$VENV/bin/python" -c "$CHECK" 2>/dev/null; then
    msg "PySide6 ist in $VENV vorhanden." "PySide6 is available in $VENV."
    exit 0
fi
if "$PYTHON" -c "$CHECK" 2>/dev/null; then
    msg "PySide6 ist als Systempaket vorhanden." "PySide6 is available as a system package."
    rm -rf "$VENV"
    exit 0
fi

msg "Keine PySide6-Systempakete gefunden (normal auf Ubuntu/Linux Mint)." \
    "No PySide6 system packages found (normal on Ubuntu/Linux Mint)."
msg "Lege virtuelle Umgebung $VENV an und lade PySide6 (~100 MB) herunter ..." \
    "Creating virtual environment $VENV and downloading PySide6 (~100 MB) ..."
rm -rf "$VENV"
mkdir -p /opt/lintask
if ! "$PYTHON" -m venv --system-site-packages "$VENV"; then
    msg "FEHLER: 'python3 -m venv' schlug fehl. Fehlt das Paket python3-venv?" \
        "ERROR: 'python3 -m venv' failed. Is the package python3-venv missing?" >&2
    rm -rf "$VENV"
    exit 1
fi

export PIP_ROOT_USER_ACTION=ignore PIP_DISABLE_PIP_VERSION_CHECK=1
if ! "$VENV/bin/python" -m pip install --no-cache-dir "PySide6-Essentials>=6.6,<7" "psutil>=5.9"; then
    echo >&2
    msg "FEHLER - PySide6 konnte nicht heruntergeladen werden." \
        "ERROR - PySide6 could not be downloaded." >&2
    if [ -n "$GERMAN" ]; then
        echo "  Dafür wird eine Internetverbindung zu pypi.org benötigt (Proxy? Offline?)." >&2
        echo "  Danach die Einrichtung einfach wiederholen:" >&2
    else
        echo "  This needs an internet connection to pypi.org (proxy? offline?)." >&2
        echo "  Afterwards simply repeat the setup:" >&2
    fi
    echo "      sudo /usr/libexec/lintask/setup-venv" >&2
    echo >&2
    rm -rf "$VENV"
    exit 1
fi

if ! "$VENV/bin/python" -c "$CHECK"; then
    msg "FEHLER: PySide6 wurde installiert, lässt sich aber nicht laden (siehe Meldung oben)." \
        "ERROR: PySide6 was installed but cannot be loaded (see the message above)." >&2
    rm -rf "$VENV"
    exit 1
fi
version="$("$VENV/bin/python" -c 'import PySide6; print(PySide6.__version__)')"
msg "Fertig - PySide6 $version in $VENV." "Done - PySide6 $version in $VENV."
