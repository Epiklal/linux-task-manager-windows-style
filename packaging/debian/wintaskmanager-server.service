[Unit]
Description=WinTaskManager monitoring server (remote monitoring)
Documentation=https://github.com/Epiklal/linux-task-manager-windows-style
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Access token, port etc. are set in /etc/default/wintaskmanager-server.
EnvironmentFile=-/etc/default/wintaskmanager-server
ExecStart=/usr/bin/wintaskmanager --server $WINTASKMANAGER_SERVER_OPTS
Restart=on-failure
RestartSec=5

# Runs unprivileged and sandboxed. To let the server read SMART and memory data through
# the task manager's sudo rule, enter a fixed user instead:
#     sudo systemctl edit wintaskmanager-server
#     [Service]
#     DynamicUser=no
#     User=yourname
DynamicUser=yes

[Install]
WantedBy=multi-user.target
