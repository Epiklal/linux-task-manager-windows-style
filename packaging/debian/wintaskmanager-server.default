# Settings for the WinTaskManager server (systemd service "wintaskmanager-server").
# Enable and start:      sudo systemctl enable --now wintaskmanager-server
# After changes here:    sudo systemctl restart wintaskmanager-server
#
# Available options (all optional):
#   --token TOKEN       fixed access token that the desktop app enters when connecting.
#                       Without --token a new token is generated at every start and
#                       written to the journal:  journalctl -u wintaskmanager-server
#   --port 8765         port (default 8765)
#   --host 0.0.0.0      address to listen on (default: all)
#   --no-auth           no access token - only on trusted networks!
#
# Example:
#WINTASKMANAGER_SERVER_OPTS="--token PLEASE-CHANGE --port 8765"
WINTASKMANAGER_SERVER_OPTS=""
