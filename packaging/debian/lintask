#!/bin/sh
# Launcher of the Debian package: the program lives in /usr/share/lintask.
# All arguments are passed through, e.g.  lintask --server --token ...
#
# PySide6 comes either from the system packages (Debian) or from the virtual
# environment /opt/lintask/venv that setup-venv creates during installation
# (Ubuntu/Linux Mint have no PySide6 packages). This only checks that the modules
# can be found, which adds next to nothing to the startup time.
APP=/usr/share/lintask/main.py
VENV=/opt/lintask/venv
CHECK='import importlib.util, sys
sys.exit(any(importlib.util.find_spec(m) is None for m in ("PySide6", "psutil")))'

for py in "$VENV/bin/python" /usr/bin/python3; do
    if [ -x "$py" ] && "$py" -c "$CHECK" 2>/dev/null; then
        exec "$py" "$APP" "$@"
    fi
done

case "${LANGUAGE:-${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}}" in
    de*) message="lintask: Die Python-Module PySide6/psutil fehlen.
Bitte einmalig im Terminal ausführen:  sudo /usr/libexec/lintask/setup-venv" ;;
    *) message="lintask: The Python modules PySide6/psutil are missing.
Please run this once in a terminal:  sudo /usr/libexec/lintask/setup-venv" ;;
esac
echo "$message" >&2
# Nobody sees stderr when started from the menu, so show a dialog there.
if [ ! -t 2 ] && { [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ]; }; then
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title=Lintask --text="$message"
    elif command -v kdialog >/dev/null 2>&1; then
        kdialog --title Lintask --error "$message"
    elif command -v xmessage >/dev/null 2>&1; then
        xmessage "$message"
    fi
fi
exit 1
