#!/bin/sh
set -e

UNIT=lintask-server.service

case "${LANGUAGE:-${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}}" in
    de*)
        MSG_COMPILE="Warnung: Byte-Compile fehlgeschlagen - das Programm läuft trotzdem."
        MSG_NEEDS_SETUP="Warnung: Lintask ist installiert, startet aber erst nach:"
        MSG_MIGRATE="Warnung: Einstellungen von WinTaskManager konnten nicht vollständig übernommen werden."
        ;;
    *)
        MSG_COMPILE="Warning: byte-compiling failed - the program still runs."
        MSG_NEEDS_SETUP="Warning: Lintask is installed, but only starts after:"
        MSG_MIGRATE="Warning: settings from WinTaskManager could not be fully taken over."
        ;;
esac

case "$1" in
    configure)
        # Byte-compile like dh_python3 (prerm removes the .pyc files again).
        if command -v py3compile >/dev/null 2>&1; then
            py3compile -p lintask /usr/share/lintask \
                || echo "$MSG_COMPILE" >&2
        fi

        # PySide6: system packages (Debian) or a virtual environment via pip (Ubuntu/
        # Linux Mint have no PySide6 packages). If that fails, e.g. without internet,
        # configuration still finishes: a half-installed package would block apt for
        # the whole system. The launcher says what to do the next time it runs.
        if ! /usr/libexec/lintask/setup-venv; then
            echo "$MSG_NEEDS_SETUP" >&2
            echo "    sudo /usr/libexec/lintask/setup-venv" >&2
        fi

        if [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload >/dev/null 2>&1 || true
        fi
        # First install: take over what the package's old name left behind. A failure
        # must not block apt either; the old settings simply stay where they are.
        if [ -z "$2" ] && [ -x /usr/libexec/lintask/migrate-wintaskmanager ]; then
            /usr/libexec/lintask/migrate-wintaskmanager \
                || echo "$MSG_MIGRATE" >&2
        fi
        # The service is not enabled automatically; a service the admin enabled stays
        # enabled across updates and is restarted.
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            if deb-systemd-helper debian-installed "$UNIT"; then
                deb-systemd-helper unmask "$UNIT" >/dev/null || true
                if deb-systemd-helper --quiet was-enabled "$UNIT"; then
                    deb-systemd-helper enable "$UNIT" >/dev/null || true
                fi
            fi
            deb-systemd-helper update-state "$UNIT" >/dev/null || true
        fi
        if [ -n "$2" ] && [ -d /run/systemd/system ] && command -v deb-systemd-invoke >/dev/null 2>&1; then
            deb-systemd-invoke try-restart "$UNIT" >/dev/null || true
        fi
        ;;
esac

exit 0
