# Maintainer: Epiklal <https://github.com/Epiklal>
#
# Arch-Paket für WinTaskManager, gebaut direkt aus dem Git-Checkout
# (kein source=-Download, kein AUR-Eintrag):
#     cd packaging/arch && makepkg -si
# makepkg zieht die Abhängigkeiten (pyside6, python-psutil, ...) per pacman nach.
# Bei Änderungen am Programm vor dem nächsten Bau pkgrel erhöhen, sonst
# aktualisiert pacman das installierte Paket nicht.
# namcap meldet "File referenced in $startdir": gewollt, die Dateien kommen
# aus dem Checkout (packaging/arch/ und zwei Ebenen darüber) statt aus source=.

pkgname=wintaskmanager
pkgver=1.0.0
pkgrel=1
pkgdesc="Task-Manager für Linux im Windows-Stil: Prozesse, Leistung, Dienste, Autostart, Benchmarks, Fernüberwachung"
arch=('any')
url="https://github.com/Epiklal/linux-task-manager-windows-style"
# Das Projekt hat noch keine Lizenzdatei (siehe packaging/debian/copyright), daher
# keine SPDX-Kennung; der Text landet unter /usr/share/licenses/wintaskmanager/.
license=('LicenseRef-Unspecified')
depends=('python>=3.9' 'pyside6>=6.6' 'python-psutil')
optdepends=('smartmontools: SMART-Werte, Temperaturen und Laufzeiten von Datenträgern'
            'dmidecode: Details zu RAM-Modulen und Mainboard'
            'lm_sensors: CPU- und Mainboard-Temperaturen'
            'pciutils: Erkennung von GPUs und anderen Geräten (lspci)'
            'sysbench: CPU- und RAM-Benchmarks'
            'fio: Datenträger-Benchmarks'
            'glmark2: GPU-Benchmark'
            'qt6-wayland: native Darstellung unter Wayland'
            'sudo: Einrichtung der Hardwaredaten (smartctl/dmidecode) aus der App heraus'
            'docker: Container-Übersicht'
            'nvidia-utils: Daten von NVIDIA-Grafikkarten (nvidia-smi)')
backup=('etc/default/wintaskmanager-server')
install=wintaskmanager.install

package() {
    local repo="$startdir/../.."
    local share="$pkgdir/usr/share/$pkgname"

    # Programmdateien - ohne Caches und Editor-Reste (wie build-deb.sh).
    install -d "$share"
    cp "$repo/main.py" "$share/"
    cp -r "$repo/app" "$repo/pages" "$repo/widgets" "$share/"
    find "$share" \( -name __pycache__ -o -name '*.py[cod]' -o -name '*.swp' -o -name '.DS_Store' \) \
        -prune -exec rm -rf {} +
    find "$share" -type d -exec chmod 755 {} +
    find "$share" -type f -exec chmod 644 {} +
    # Bytecode gleich mit ins Paket, damit pacman ihn kennt und beim Entfernen löscht.
    python -m compileall -q -d "/usr/share/$pkgname" "$share"

    install -Dm755 "$startdir/wintaskmanager" "$pkgdir/usr/bin/$pkgname"
    # Privilegierter Helfer für smartctl/dmidecode; die App legt die sudo-Regel dafür an.
    install -Dm755 "$repo/scripts/wintaskmanager-smartctl" "$pkgdir/usr/lib/$pkgname/wintaskmanager-smartctl"

    # Menüeintrag: dieselbe Vorlage wie install.sh, nur mit dem Starter aus /usr/bin.
    install -d "$pkgdir/usr/share/applications"
    sed -e 's|^Exec=.*|TryExec=wintaskmanager\nExec=wintaskmanager|' "$repo/wintaskmanager.desktop.in" \
        > "$pkgdir/usr/share/applications/$pkgname.desktop"
    chmod 644 "$pkgdir/usr/share/applications/$pkgname.desktop"

    # Fernüberwachung als systemd-Dienst (optional, siehe .install-Hinweise).
    install -Dm644 "$repo/packaging/debian/wintaskmanager-server.service" \
        "$pkgdir/usr/lib/systemd/system/wintaskmanager-server.service"
    # Enthält später den Zugriffsschlüssel, daher nur für root lesbar.
    install -Dm600 "$repo/packaging/debian/wintaskmanager-server.default" \
        "$pkgdir/etc/default/$pkgname-server"

    install -Dm644 "$repo/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$repo/packaging/debian/copyright" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
