# Install hooks of the Arch package (pacman runs them after unpacking).

post_install() {
    systemctl daemon-reload >/dev/null 2>&1 || true
    cat <<'MSG'
==> WinTaskManager: start "Task Manager" from the application menu or run  wintaskmanager  in a terminal.
==> Remote monitoring (optional):  sudo systemctl enable --now wintaskmanager-server
    Access token and port: /etc/default/wintaskmanager-server
MSG
}

post_upgrade() {
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl try-restart wintaskmanager-server.service >/dev/null 2>&1 || true
}

pre_remove() {
    systemctl disable --now wintaskmanager-server.service >/dev/null 2>&1 || true
}

post_remove() {
    systemctl daemon-reload >/dev/null 2>&1 || true
    # Also remove what the app set up (sudo rule for the helper, udev rule).
    if grep -qs '/usr/lib/wintaskmanager/' /etc/sudoers.d/wintaskmanager-smartctl; then
        rm -f /etc/sudoers.d/wintaskmanager-smartctl
    fi
    rm -f /etc/udev/rules.d/99-wintaskmanager-rapl.rules
    # Leftovers such as __pycache__ from runs as root.
    rm -rf /usr/share/wintaskmanager
    rmdir /usr/lib/wintaskmanager 2>/dev/null || true
}
